@{
    ViewData["Title"] = "Acceso denegado";
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme-dark.css" asp-append-version="true" />
}

<div class="pagetitle">
    <h1>Acceso denegado</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
            </li>
            <li class="breadcrumb-item active">Acceso denegado</li>
        </ol>
    </nav>
</div>

<section class="section access-denied-page">
    <div class="access-denied-card text-center">

        <div class="access-denied-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h2 class="access-denied-title">
            No tienes permiso para acceder a este recurso
        </h2>

        <p class="access-denied-text">
            Tu usuario no cuenta con los permisos necesarios para ingresar a esta sección de AutoRent Colombia.
            Si crees que esto es un error, comunícate con el administrador del sistema.
        </p>

        <div class="access-denied-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-house-door"></i>
                Volver al inicio
            </a>
        </div>

    </div>
</section>