@model IRolePermissionsForm 

<div class="row">

    @foreach (var group in Model.PermissionModules)
    {
        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-header py-2 bg-transparent">
                    <h6 class="mb-0 text-primary fw-bold">
                        @group.Module
                    </h6>
                </div>

                <div class="card-body py-3" style="max-height:250px; overflow-y:auto;">

                    @foreach (var permission in group.Permissions)
                    {
                        bool isChecked = Model.PermissionIds.Contains(permission.Id);
                        <div class="form-check mb-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="PermissionIds"
                                   value="@permission.Id"
                                   id="perm_@permission.Id"
                                   checked="@isChecked" />

                            <label class="form-check-label" for="perm_@permission.Id">
                                @permission.Description
                            </label>
                        </div>
                    }

                </div>
            </div>
        </div>
    }

</div>
