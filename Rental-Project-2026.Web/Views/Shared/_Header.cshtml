@inject IMediator Mediator


@{
    Rental_Project_2026.Application.UseCases.Account.Queries.GetAccountUserInfo.UserAccountInfoDTO user = null;

    try
    {
        if (User.Identity?.IsAuthenticated == true)
        {
            string? userId = User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (!string.IsNullOrWhiteSpace(userId))
            {
                user = await Mediator.Send(new Rental_Project_2026.Application
                                                                 .UseCases
                                                                 .Account
                                                                 .Queries
                                                                 .GetAccountUserInfo
                                                                 .GetAccountUserInfoQuery { UserId = userId });

            }
        }

    }
    catch
    {

        user = null;
    }

}

<header id="header" class="header fixed-top d-flex align-items-center">

    <div class="d-flex align-items-center justify-content-between">
        <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
            <img src="~/images/LogoP.png" alt="AutoRent Colombia" class="main-logo">
        </a>
        <i class="bi bi-list toggle-sidebar-btn"></i>
    </div>

    <nav class="header-nav ms-auto">
        <ul class="d-flex align-items-center">
     
            <li class="nav-item dropdown pe-3">
                
                @if(user is not null)
                {
                    <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
                        <img src="~/assets/img/profile-img.jpg" alt="Perfil" class="rounded-circle">
                        <span class="d-none d-md-block dropdown-toggle ps-2">
                            @(user.FirsName.Substring(0,1)). @user.LastName
                        </span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">

                        <li class="dropdown-header">
                            <h6>@user.FullName</h6>
                            <span>@user.RoleName</span>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" href="users-profile.html">
                                <i class="bi bi-person"></i>
                                <span>Mi Perfil</span>
                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-0 mb-0">
                                <button type="submit" class="dropdown-item d-flex aling-items-center border-0 bg-trasnparent w-100 text-start">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Cerrar Sesion</span>
                                </button>
                            </form>

                        </li>

                    </ul>
                }
                else
                {
                    <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Iniciar Sesion</span>
                    </a>
                }

            </li>
        </ul>
    </nav>

</header>